# Endereço público do site. Sai daqui a URL canônica, o sitemap.xml,
# o robots.txt e as tags de compartilhamento (WhatsApp, Facebook).
#
# Copie este arquivo para `.env` e ajuste. Sem barra no final.
#
# Enquanto o domínio próprio não estiver apontado, use o endereço provisório
# que a Hostinger mostra no hPanel:
SITE_URL=https://seusite.hostingersite.com

# Depois que o domínio estiver ativo, troque por ele — e confira se a escolha
# entre com/sem www bate com o bloco de redirecionamento em public/.htaccess:
# SITE_URL=https://newmotopoint.com.br
