---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { ofertas, desconto } from '../data/catalogo';
import { zap } from '../data/site';

const maiorOff = Math.max(...ofertas.map((o) => desconto(o) ?? 0));
---

<section id="ofertas" class="bg-creme-100 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <TituloSecao
        sobretitulo="Ofertas da loja"
        titulo="Luva e roupa térmica com até"
        destaque={`${maiorOff}% off`}
        texto="Estoque limitado, tamanhos e modelos conforme disponibilidade. Confirme no WhatsApp e retire na loja ou peça tele entrega."
      />

      <a
        href={zap('Olá! Quero saber quais ofertas ainda estão disponíveis na New Moto Point.')}
        target="_blank"
        rel="noopener"
        class="reveal group inline-flex shrink-0 items-center gap-2.5 self-start rounded-full border border-tinta-950/20 px-6 py-3 text-sm font-semibold text-tinta-950 transition-all hover:border-ambar-500 hover:bg-ambar-400 lg:self-auto"
      >
        Ver disponibilidade
        <Icone
          nome="seta"
          class="size-4.5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
      {ofertas.map((p, i) => <CardProduto produto={p} atraso={(i % 4) * 60} />)}
    </div>

    <p class="reveal mt-8 flex items-start gap-2.5 text-xs leading-relaxed text-tinta-500 sm:items-center">
      <Icone nome="check" class="mt-0.5 size-4 shrink-0 text-ambar-500 sm:mt-0" />
      Preços à vista. Trabalhamos com pagamento facilitado — pergunte as condições no atendimento.
    </p>
  </div>
</section>
