---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import { fotos, depoimentos } from '../data/servicos';
import faixa from '../assets/img/brand/faixa-pecas-acessorios-oficina.jpg';
import { site, redes } from '../data/site';
---

<section id="loja" class="relative overflow-hidden bg-tinta-950 py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
      <!-- Fotos coladas na página -->
      <div class="reveal relative">
        <div class="foto-torta overflow-hidden border-8 border-creme-50 shadow-2xl shadow-black/50">
          <Image
            src={fotos.trocaOleo}
            alt="Troca de óleo sendo feita na oficina da New Moto Point"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 46vw, 92vw"
            loading="lazy"
            decoding="async"
            class="aspect-4/3 w-full object-cover"
          />
        </div>

        <div
          class="absolute -right-2 -bottom-10 w-40 rotate-3 overflow-hidden border-8 border-creme-50 shadow-2xl shadow-black/50 sm:w-52 lg:-right-6"
        >
          <Image
            src={fotos.centragem}
            alt="Centragem de roda na bancada da New Moto Point"
            widths={[220, 400]}
            sizes="13rem"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full object-cover"
          />
        </div>
      </div>

      <!-- História -->
      <div class="mt-14 lg:mt-0">
        <TituloSecao
          escuro
          sobretitulo="A loja"
          titulo="Na mesma esquina"
          destaque={`desde ${site.desde}.`}
        />

        <div class="reveal mt-6 space-y-4 text-[15px] leading-relaxed text-white/60">
          <p>
            A New Moto Point nasceu em {site.desde} na Av. Farrapos, esquina com a Rua Hoffmann, no
            bairro Floresta. A ideia sempre foi simples: reunir <strong
              class="font-semibold text-white">peça, acessório e oficina</strong
            > num só lugar, para o motociclista não perder o dia inteiro rodando de loja em loja.
          </p>
          <p>
            Atendemos muito entregador e quem usa a moto para trabalhar — gente que não pode ficar
            parada. Por isso o orçamento sai rápido pelo WhatsApp, a oficina tem mão de obra
            certificada <strong class="font-semibold text-white">SENAC RS</strong> e a gente mantém
            tele entrega e busca na região.
          </p>
        </div>

        <Image
          src={faixa}
          alt="Peças, acessórios e oficina — New Moto Point"
          widths={[500, 900, 1200]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          loading="lazy"
          decoding="async"
          class="reveal mt-8 w-full"
        />

        <a
          href={redes.instagram}
          target="_blank"
          rel="noopener"
          class="reveal group mt-7 inline-flex items-center gap-2.5 text-sm font-semibold text-white transition-colors hover:text-ambar-300"
        >
          <Icone nome="instagram" class="size-5 text-ambar-400" />
          Ver o dia a dia da loja no {redes.instagramHandle}
          <Icone
            nome="setaCurta"
            class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>
    </div>

    <!-- Depoimentos reais do Google -->
    <div class="mt-24 lg:mt-32">
      <div class="reveal flex flex-wrap items-baseline gap-x-4 gap-y-2">
        <p class="display text-2xl text-white sm:text-3xl">O que dizem no Google</p>
        <p class="text-sm text-white/40">Avaliações publicadas no perfil da loja</p>
      </div>

      <div class="mt-9 grid gap-6 lg:grid-cols-2">
        {
          depoimentos.map((d, i) => (
            <figure
              class="reveal flex flex-col bg-creme-50 p-7 lg:p-8"
              style={`--reveal-delay:${i * 100}ms`}
            >
              <div class="flex gap-0.5 text-ambar-500">
                {Array.from({ length: 5 }).map(() => (
                  <Icone nome="estrela" class="size-4" />
                ))}
              </div>
              <blockquote class="display mt-5 flex-1 text-lg leading-snug text-tinta-800 sm:text-xl">
                {d.texto}
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3 border-t border-tinta-950/12 pt-5">
                <span class="display flex size-11 items-center justify-center rounded-full bg-ambar-400 text-xl text-tinta-950">
                  {d.autor.charAt(0)}
                </span>
                <span>
                  <span class="block text-sm font-semibold text-tinta-950">{d.autor}</span>
                  <span class="block text-xs text-tinta-500">{d.origem}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
