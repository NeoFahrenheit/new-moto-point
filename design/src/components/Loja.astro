---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import { depoimentos } from '../data/servicos';
import faixa from '../assets/img/brand/faixa-pecas-acessorios-oficina.jpg';
import { site, redes } from '../data/site';

const anos = new Date().getFullYear() - site.desde;
---

<section id="loja" class="relative overflow-hidden bg-carbon-900 py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <!-- História da loja -->
      <div>
        <TituloSecao
          sobretitulo="A loja"
          titulo="Três negócios no mesmo balcão"
          destaque={`desde ${site.desde}.`}
        />

        <div class="reveal mt-6 space-y-4 text-[15px] leading-relaxed text-white/60">
          <p>
            A New Moto Point nasceu em {site.desde} na Av. Farrapos, esquina com a Rua Hoffmann, no
            bairro Floresta. A ideia sempre foi simples: reunir <strong
              class="font-semibold text-white">peça, acessório e oficina</strong
            > num só lugar, para o motociclista não perder o dia inteiro rodando de loja em loja.
          </p>
          <p>
            Atendemos muito entregador e quem usa a moto para trabalhar — gente que não pode ficar
            parada. Por isso o orçamento sai rápido pelo WhatsApp, a oficina tem mão de obra
            certificada <strong class="font-semibold text-white">SENAC RS</strong> e a gente mantém
            tele entrega e busca na região.
          </p>
        </div>

        <dl class="reveal mt-9 grid grid-cols-3 gap-px border border-white/10 bg-white/10">
          {
            [
              { valor: `${anos}`, rotulo: 'anos na Farrapos' },
              { valor: '3 em 1', rotulo: 'loja, peça e oficina' },
              { valor: '5', rotulo: 'marcas atendidas' },
            ].map((n) => (
              <div class="bg-carbon-900 px-4 py-6 text-center">
                <dt class="sr-only">{n.rotulo}</dt>
                <dd>
                  <span class="display block text-3xl text-rubi-500 lg:text-4xl">{n.valor}</span>
                  <span class="rotulo mt-2 block text-[9px] text-white/40">{n.rotulo}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          href={redes.instagram}
          target="_blank"
          rel="noopener"
          class="reveal group mt-8 inline-flex items-center gap-2.5 text-[13px] font-extrabold tracking-wider text-white uppercase transition-colors hover:text-rubi-400"
        >
          <Icone nome="instagram" class="size-5 text-rubi-500" />
          Ver o dia a dia no {redes.instagramHandle}
          <Icone
            nome="setaCurta"
            class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>

      <!-- Faixa da loja + depoimentos -->
      <div class="flex flex-col gap-6">
        <Image
          src={faixa}
          alt="Peças, acessórios e oficina — New Moto Point"
          widths={[500, 900, 1200]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          loading="lazy"
          decoding="async"
          class="reveal w-full border border-white/10"
        />

        <div class="reveal flex items-baseline gap-3">
          <p class="display text-xl text-white sm:text-2xl">O que dizem no Google</p>
          <p class="text-xs text-white/40">Avaliações do perfil da loja</p>
        </div>

        {
          depoimentos.map((d, i) => (
            <figure
              class="reveal relative border-l-2 border-rubi-500 bg-carbon-850 p-6"
              style={`--reveal-delay:${i * 90}ms`}
            >
              <div class="flex gap-0.5 text-rubi-500">
                {Array.from({ length: 5 }).map(() => (
                  <Icone nome="estrela" class="size-4" />
                ))}
              </div>
              <blockquote class="mt-4 text-sm leading-relaxed text-white/70">{d.texto}</blockquote>
              <figcaption class="mt-5 flex items-center gap-3 border-t border-white/8 pt-4">
                <span class="display flex size-10 items-center justify-center rounded-full bg-rubi-500/15 text-lg text-rubi-400">
                  {d.autor.charAt(0)}
                </span>
                <span>
                  <span class="block text-sm font-bold text-white">{d.autor}</span>
                  <span class="block text-xs text-white/40">{d.origem}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
