---
import Icone from './Icone.astro';
import { zap } from '../data/site';
---

<a
  href={zap()}
  target="_blank"
  rel="noopener"
  class="group fixed right-4 bottom-4 z-50 flex items-center gap-3 rounded-sm bg-zap-500 py-3.5 pr-5 pl-4 font-bold text-carbon-950 shadow-2xl shadow-black/60 transition-all duration-300 hover:bg-zap-400 sm:right-6 sm:bottom-6"
  aria-label="Falar com a New Moto Point no WhatsApp"
>
  <span class="relative flex size-6 items-center justify-center">
    <span
      class="absolute inset-0 animate-ping rounded-full bg-carbon-950/25 motion-reduce:animate-none"
    ></span>
    <Icone nome="whatsapp" class="relative size-6" />
  </span>
  <span class="hidden text-sm tracking-wide uppercase sm:inline">Chamar no zap</span>
</a>
