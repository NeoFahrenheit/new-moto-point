---
import Icone from './Icone.astro';
import { etapas } from '../data/servicos';
import { zap } from '../data/site';
---

<!-- Linha do tempo do atendimento: quatro marcos ligados por um trilho. -->
<section id="como-funciona" class="relative overflow-hidden bg-carbon-950 py-20 lg:py-28">
  <div class="textura-pontos absolute inset-0 opacity-40"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="rotulo flex items-center justify-center gap-3 text-[11px] text-rubi-400">
        <span class="hachura block h-2.5 w-8 bg-rubi-500"></span>
        Como funciona
      </p>
      <h2 class="display mt-5 text-[2rem] text-white sm:text-5xl">
        Do WhatsApp à moto pronta em <span class="text-rubi-500">4 passos</span>
      </h2>
    </div>

    <ol class="relative mt-16 grid gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-8">
      <!-- Trilho contínuo por trás dos marcos (só no desktop) -->
      <span
        class="absolute top-7 right-0 left-0 hidden h-px bg-linear-to-r from-rubi-600/0 via-rubi-600 to-rubi-600/0 lg:block"
        aria-hidden="true"></span>

      {
        etapas.map((e, i) => (
          <li class="reveal relative lg:px-3" style={`--reveal-delay:${i * 90}ms`}>
            <span class="grad-rubi relative z-10 flex size-14 items-center justify-center rounded-full text-xl font-extrabold text-white shadow-lg shadow-rubi-900/50">
              {e.n}
            </span>
            <h3 class="display mt-6 text-xl text-white lg:text-2xl">{e.titulo}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/55">{e.texto}</p>
          </li>
        ))
      }
    </ol>

    <div
      class="reveal mt-16 flex flex-col gap-5 border-t border-white/10 pt-10 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="display max-w-lg text-2xl text-white sm:text-3xl">
        Quanto antes você chama, antes a moto volta para a rua.
      </p>
      <a
        href={zap()}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center justify-center gap-2.5 rounded-sm bg-zap-500 px-7 py-4 font-extrabold tracking-wide text-carbon-950 uppercase transition-all hover:bg-zap-400"
      >
        <Icone nome="whatsapp" class="size-5.5" />
        Chamar no WhatsApp
        <Icone
          nome="seta"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
