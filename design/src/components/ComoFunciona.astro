---
import Icone from './Icone.astro';
import { etapas } from '../data/servicos';
import { zap } from '../data/site';
---

<section id="como-funciona" class="bg-creme-100 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="rotulo flex items-center justify-center gap-3 text-[10px] text-ambar-600">
        <span class="block h-px w-8 bg-ambar-500"></span>
        Como funciona
      </p>
      <h2 class="display mt-5 text-[2.1rem] text-tinta-950 sm:text-5xl">
        Do WhatsApp à moto pronta em <span class="text-ambar-500 italic">4 passos</span>
      </h2>
    </div>

    <ol class="mt-16 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        etapas.map((e, i) => (
          <li
            class="reveal border-t border-tinta-950/20 pt-6"
            style={`--reveal-delay:${i * 80}ms`}
          >
            <span class="display block text-5xl text-ambar-500 lg:text-6xl">{e.n}</span>
            <h3 class="display mt-5 text-xl text-tinta-950 lg:text-2xl">{e.titulo}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-tinta-500">{e.texto}</p>
          </li>
        ))
      }
    </ol>

    <div
      class="reveal mt-16 flex flex-col gap-5 border-t border-tinta-950/14 pt-10 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="display max-w-lg text-2xl text-tinta-950 sm:text-3xl">
        Quanto antes você chama, <span class="text-ambar-500 italic">antes a moto volta para a rua.</span>
      </p>
      <a
        href={zap()}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center justify-center gap-2.5 rounded-full bg-tinta-950 px-7 py-4 font-semibold text-white transition-all hover:bg-ambar-400 hover:text-tinta-950"
      >
        <Icone nome="whatsapp" class="size-5" />
        Chamar no WhatsApp
        <Icone
          nome="seta"
          class="size-4.5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
