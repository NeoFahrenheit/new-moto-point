---
interface Props {
  sobretitulo: string;
  titulo: string;
  destaque?: string;
  texto?: string;
  centro?: boolean;
  claro?: boolean;
}

const {
  sobretitulo,
  titulo,
  destaque,
  texto,
  centro = false,
  claro = false,
} = Astro.props;
---

<div class:list={['reveal', centro ? 'mx-auto max-w-3xl text-center' : 'max-w-2xl']}>
  <p
    class:list={[
      'rotulo flex items-center gap-3 text-[11px]',
      centro && 'justify-center',
      claro ? 'text-rubi-600' : 'text-rubi-400',
    ]}
  >
    <span class="hachura block h-2.5 w-8 bg-rubi-500"></span>
    {sobretitulo}
  </p>

  <h2
    class:list={[
      'display mt-5 text-[2rem] sm:text-5xl lg:text-[3.25rem]',
      claro ? 'text-carbon-950' : 'text-white',
    ]}
  >
    {titulo}
    {destaque && <span class="text-rubi-500"> {destaque}</span>}
  </h2>

  {
    texto && (
      <p
        class:list={[
          'mt-5 text-[15px] leading-relaxed sm:text-base',
          centro && 'mx-auto max-w-2xl',
          claro ? 'text-carbon-600' : 'text-white/55',
        ]}
      >
        {texto}
      </p>
    )
  }
</div>
