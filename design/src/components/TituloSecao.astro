---
interface Props {
  sobretitulo: string;
  titulo: string;
  destaque?: string;
  texto?: string;
  centro?: boolean;
  /** `escuro` inverte as cores para uso sobre as faixas pretas. */
  escuro?: boolean;
}

const {
  sobretitulo,
  titulo,
  destaque,
  texto,
  centro = false,
  escuro = false,
} = Astro.props;
---

<div class:list={['reveal', centro ? 'mx-auto max-w-3xl text-center' : 'max-w-2xl']}>
  <p
    class:list={[
      'rotulo flex items-center gap-3 text-[10px]',
      centro && 'justify-center',
      escuro ? 'text-ambar-400' : 'text-ambar-600',
    ]}
  >
    <span class="block h-px w-8 bg-ambar-500"></span>
    {sobretitulo}
  </p>

  <h2
    class:list={[
      'display mt-5 text-[2.1rem] sm:text-5xl lg:text-[3.4rem]',
      escuro ? 'text-white' : 'text-tinta-950',
    ]}
  >
    {titulo}
    {destaque && <span class="text-ambar-500 italic"> {destaque}</span>}
  </h2>

  {
    texto && (
      <p
        class:list={[
          'mt-6 text-[15px] leading-relaxed sm:text-base',
          centro && 'mx-auto max-w-2xl',
          escuro ? 'text-white/55' : 'text-tinta-500',
        ]}
      >
        {texto}
      </p>
    )
  }
</div>
