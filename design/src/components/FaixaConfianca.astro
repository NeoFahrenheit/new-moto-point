---
import Icone from './Icone.astro';
import { diferenciais } from '../data/servicos';
---

<section class="relative border-y border-white/8 bg-graphite-850" aria-label="Nossos diferenciais">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <ul
      class="grid divide-y divide-white/8 sm:grid-cols-2 sm:divide-x lg:grid-cols-4 lg:divide-y-0"
    >
      {
        diferenciais.map((d, i) => (
          <li
            class="reveal group flex gap-4 py-7 sm:px-7 sm:first:pl-0 sm:last:pr-0 lg:py-9"
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-moto-500/12 text-moto-500 transition-colors duration-300 group-hover:bg-moto-500 group-hover:text-white">
              <Icone nome={d.icone} class="size-6" />
            </span>
            <div>
              <h3 class="display text-xl tracking-wide text-white">{d.titulo}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-white/50">{d.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
