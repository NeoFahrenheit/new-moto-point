---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import { fotos } from '../data/servicos';
import { redes } from '../data/site';

/** Mosaico assimétrico: a primeira foto ocupa o dobro do espaço. */
const quadros = [
  { img: fotos.manutencao, titulo: 'Manutenção geral', span: 'sm:col-span-2 sm:row-span-2' },
  { img: fotos.trocaOleo, titulo: 'Troca de óleo', span: '' },
  { img: fotos.centragem, titulo: 'Centragem de roda', span: '' },
  { img: fotos.pneu, titulo: 'Pneu e roda', span: '' },
  { img: fotos.capaBanco, titulo: 'Capa de banco', span: '' },
];
---

<section id="galeria" class="relative overflow-hidden bg-carbon-900 py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <TituloSecao
        sobretitulo="Na bancada"
        titulo="Serviço que a gente"
        destaque="mostra."
        texto="Fotos da própria oficina na Av. Farrapos. Nada de banco de imagens: é o serviço que sai daqui todo dia."
      />

      <a
        href={redes.instagram}
        target="_blank"
        rel="noopener"
        class="reveal group inline-flex shrink-0 items-center gap-2.5 self-start rounded-sm border border-white/18 px-6 py-3.5 text-[13px] font-extrabold tracking-wider text-white uppercase transition-all hover:border-rubi-500 hover:bg-rubi-500 lg:self-auto"
      >
        <Icone nome="instagram" class="size-5 text-rubi-400 transition-colors group-hover:text-white" />
        Ver no {redes.instagramHandle}
      </a>
    </div>

    <div class="mt-12 grid auto-rows-[11rem] grid-cols-2 gap-3 sm:auto-rows-[13rem] sm:grid-cols-4 lg:auto-rows-[15rem]">
      {
        quadros.map((q, i) => (
          <figure
            class:list={[
              'reveal group relative overflow-hidden bg-carbon-850',
              q.span,
            ]}
            style={`--reveal-delay:${i * 70}ms`}
          >
            <Image
              src={q.img}
              alt={`${q.titulo} na oficina da New Moto Point`}
              widths={[300, 600, 900]}
              sizes="(min-width: 640px) 30vw, 50vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-700 ease-out-quint group-hover:scale-108"
            />
            <div class="absolute inset-0 bg-linear-to-t from-carbon-950 via-carbon-950/25 to-transparent opacity-85 transition-opacity duration-500 group-hover:opacity-95" />
            <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-rubi-500 transition-transform duration-500 group-hover:scale-x-100" />
            <figcaption class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
              <span class="display text-base text-white sm:text-lg">{q.titulo}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
