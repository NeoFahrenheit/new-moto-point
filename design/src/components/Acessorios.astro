---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { vitrines, semFoto } from '../data/catalogo';
import { zap } from '../data/site';

// Vitrines de acessórios (óleos ficam na seção de peças)
const grupos = vitrines.filter((v) => v.id !== 'oleos');

const iconePorGrupo: Record<string, string> = {
  chuva: 'chuva',
  baus: 'bau',
  viseiras: 'viseira',
};
---

<section id="acessorios" class="relative overflow-hidden bg-carbon-900 py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSecao
      sobretitulo="Acessórios"
      titulo="Equipamento para quem roda"
      destaque="chova ou faça sol."
      texto="Capa de chuva, bota, baú, grelha e viseira original. Compre agora e retire na loja ou peça tele entrega."
    />

    <div class="mt-14 space-y-16 lg:space-y-20">
      {
        grupos.map((g, gi) => (
          <div id={g.id} class="scroll-mt-28">
            <div class="reveal flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
              <div class="flex items-start gap-5">
                <span class="display numero-vazado shrink-0 text-5xl leading-none lg:text-6xl">
                  {String(gi + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="display flex items-center gap-3 text-2xl text-white sm:text-3xl">
                    <Icone nome={iconePorGrupo[g.id] ?? 'check'} class="size-6 text-rubi-500" />
                    {g.titulo}
                  </h3>
                  <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-white/55">
                    {g.descricao}
                  </p>
                </div>
              </div>
              <span class="rotulo shrink-0 text-[10px] text-white/35">
                {g.itens.length} {g.itens.length === 1 ? 'item' : 'itens'}
              </span>
            </div>

            <div class="mt-6 h-0.5 w-full bg-white/10">
              <span class="block h-0.5 w-24 bg-rubi-500" />
            </div>

            <div class="mt-7 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
              {g.itens.map((p, i) => (
                <CardProduto produto={p} atraso={(i % 4) * 60} />
              ))}
            </div>

            {g.id === 'baus' && (
              <p class="reveal mt-6 flex items-center gap-2.5 text-sm text-white/45">
                <Icone nome="check" class="size-4 shrink-0 text-rubi-500" />
                Também disponível na loja: {semFoto.join(', ')}.
              </p>
            )}
          </div>
        ))
      }
    </div>

    <div
      class="reveal mt-16 flex flex-col items-start gap-5 border border-white/10 bg-carbon-850 p-7 sm:flex-row sm:items-center sm:justify-between lg:p-9"
    >
      <div>
        <h3 class="display text-2xl text-white sm:text-3xl">
          Não achou o modelo ou o tamanho?
        </h3>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/55">
          O catálogo do site é uma amostra. Manda uma foto ou o nome do item no WhatsApp que a
          gente confere no estoque e passa o valor.
        </p>
      </div>
      <a
        href={zap('Olá! Estou procurando um acessório: ')}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center gap-2.5 rounded-sm bg-zap-500 px-6 py-4 font-extrabold tracking-wide text-carbon-950 uppercase transition-all hover:bg-zap-400"
      >
        <Icone nome="whatsapp" class="size-5" />
        Perguntar no zap
        <Icone
          nome="seta"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
