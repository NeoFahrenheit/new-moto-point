---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { vitrines, semFoto } from '../data/catalogo';
import { zap } from '../data/site';

// Vitrines de acessórios (óleos ficam na seção de peças)
const grupos = vitrines.filter((v) => v.id !== 'oleos');

const iconePorGrupo: Record<string, string> = {
  chuva: 'chuva',
  baus: 'bau',
  viseiras: 'viseira',
};
---

<section id="acessorios" class="bg-creme-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSecao
      sobretitulo="Acessórios"
      titulo="Equipamento para quem roda"
      destaque="chova ou faça sol."
      texto="Capa de chuva, bota, baú, grelha e viseira original. Compre agora e retire na loja ou peça tele entrega."
    />

    <div class="mt-14 space-y-16 lg:space-y-20">
      {
        grupos.map((g) => (
          <div id={g.id} class="scroll-mt-28">
            <div class="reveal flex flex-col gap-4 border-b border-tinta-950/14 pb-5 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h3 class="display flex items-center gap-3 text-[1.75rem] text-tinta-950 sm:text-4xl">
                  <Icone nome={iconePorGrupo[g.id] ?? 'check'} class="size-6 text-ambar-500" />
                  {g.titulo}
                </h3>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-tinta-500">{g.descricao}</p>
              </div>
              <span class="rotulo shrink-0 text-[10px] text-tinta-400">
                {g.itens.length} {g.itens.length === 1 ? 'item' : 'itens'}
              </span>
            </div>

            <div class="mt-7 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
              {g.itens.map((p, i) => (
                <CardProduto produto={p} atraso={(i % 4) * 60} />
              ))}
            </div>

            {g.id === 'baus' && (
              <p class="reveal mt-6 flex items-center gap-2.5 text-sm text-tinta-500">
                <Icone nome="check" class="size-4 shrink-0 text-ambar-500" />
                Também disponível na loja: {semFoto.join(', ')}.
              </p>
            )}
          </div>
        ))
      }
    </div>

    <div
      class="reveal mt-16 flex flex-col items-start gap-6 border-y border-tinta-950/14 py-10 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h3 class="display text-2xl text-tinta-950 sm:text-3xl">
          Não achou o modelo ou o tamanho?
        </h3>
        <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-tinta-500">
          O catálogo do site é uma amostra. Manda uma foto ou o nome do item no WhatsApp que a
          gente confere no estoque e passa o valor.
        </p>
      </div>
      <a
        href={zap('Olá! Estou procurando um acessório: ')}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center gap-2.5 rounded-full bg-tinta-950 px-7 py-3.5 font-semibold text-white transition-all hover:bg-ambar-400 hover:text-tinta-950"
      >
        <Icone nome="whatsapp" class="size-5" />
        Perguntar no WhatsApp
        <Icone
          nome="seta"
          class="size-4.5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
