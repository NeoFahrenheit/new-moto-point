---
import Icone from './Icone.astro';
import TituloSecao from './TituloSecao.astro';
import CardProduto from './CardProduto.astro';
import { vitrines, semFoto } from '../data/catalogo';
import { zap } from '../data/site';

// Vitrines de acessórios (óleos ficam na seção de peças)
const grupos = vitrines.filter((v) => v.id !== 'oleos');

const iconePorGrupo: Record<string, string> = {
  chuva: 'chuva',
  baus: 'bau',
  viseiras: 'viseira',
};
---

<section id="acessorios" class="relative overflow-hidden bg-graphite-900 py-20 lg:py-28">
  <div
    class="absolute top-1/3 -right-40 size-[32rem] rounded-full bg-moto-700/12 blur-[130px]"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSecao
      sobretitulo="Acessórios"
      titulo="Equipamento para quem roda"
      destaque="chova ou faça sol."
      texto="Capa de chuva, bota, baú, grelha e viseira original. Compre agora e retire na loja ou peça tele entrega."
    />

    <div class="mt-14 space-y-16 lg:space-y-20">
      {
        grupos.map((g) => (
          <div id={g.id} class="scroll-mt-28">
            <div class="reveal flex flex-col gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
              <div class="flex items-start gap-4">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-moto-500/12 text-moto-500">
                  <Icone nome={iconePorGrupo[g.id] ?? 'check'} class="size-6" />
                </span>
                <div>
                  <h3 class="display text-3xl tracking-wide text-white sm:text-4xl">{g.titulo}</h3>
                  <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/55">{g.descricao}</p>
                </div>
              </div>
              <span class="shrink-0 text-xs font-bold tracking-[0.16em] text-white/35 uppercase">
                {g.itens.length} {g.itens.length === 1 ? 'item' : 'itens'}
              </span>
            </div>

            <div class="mt-7 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
              {g.itens.map((p, i) => (
                <CardProduto produto={p} atraso={(i % 4) * 60} />
              ))}
            </div>

            {g.id === 'baus' && (
              <p class="reveal mt-6 flex items-center gap-2.5 text-sm text-white/45">
                <Icone nome="check" class="size-4 shrink-0 text-moto-500" />
                Também disponível na loja: {semFoto.join(', ')}.
              </p>
            )}
          </div>
        ))
      }
    </div>

    <div
      class="reveal mt-16 flex flex-col items-start gap-5 rounded-2xl border border-white/8 bg-graphite-850 p-7 sm:flex-row sm:items-center sm:justify-between lg:p-9"
    >
      <div>
        <h3 class="display text-2xl text-white sm:text-3xl">
          Não achou o modelo ou o tamanho que precisa?
        </h3>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/55">
          O catálogo do site é uma amostra. Manda uma foto ou o nome do item no WhatsApp que a
          gente confere no estoque e passa o valor.
        </p>
      </div>
      <a
        href={zap('Olá! Estou procurando um acessório: ')}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center gap-2.5 rounded-xl bg-zap-500 px-6 py-4 font-bold text-graphite-950 shadow-lg shadow-zap-500/20 transition-all hover:bg-zap-400"
      >
        <Icone nome="whatsapp" class="size-5" />
        Perguntar no WhatsApp
        <Icone
          nome="seta"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
