---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { moeda, desconto, type Produto } from '../data/catalogo';
import { zapProduto } from '../data/site';

interface Props {
  produto: Produto;
  /** Cartão claro (padrão) ou sobre fundo escuro. */
  tema?: 'claro' | 'escuro';
  atraso?: number;
}

const { produto: p, tema = 'claro', atraso = 0 } = Astro.props;

const off = desconto(p);
const precoFmt = p.preco ? moeda.format(p.preco) : null;
const escuro = tema === 'escuro';
const href = zapProduto(p.nome + (p.tamanhos ? ` — tam. ${p.tamanhos}` : ''), precoFmt ?? undefined);
const rotuloBotao = precoFmt ? `Quero este: ${p.nome}` : `Pedir orçamento de ${p.nome}`;
---

<article
  class:list={[
    'reveal group relative flex flex-col border transition-all duration-300',
    escuro
      ? 'border-white/12 bg-tinta-900 hover:border-ambar-400/60'
      : 'border-tinta-950/12 bg-white hover:border-ambar-400',
  ]}
  style={atraso ? `--reveal-delay:${atraso}ms` : undefined}
>
  {
    off !== null && (
      <span class="absolute top-3 left-3 z-10 rounded-full bg-ambar-400 px-2.5 py-1 text-[11px] font-bold text-tinta-950">
        −{off}%
      </span>
    )
  }

  <!-- Foto sempre em fundo branco: os produtos foram fotografados em estúdio -->
  <div class="relative aspect-square overflow-hidden bg-white p-4">
    <Image
      src={p.img}
      alt={p.nome}
      widths={[240, 400, 600]}
      sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 80vw"
      loading="lazy"
      decoding="async"
      class="size-full object-contain transition-transform duration-500 ease-out-quint group-hover:scale-[1.06]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex-1">
      {
        p.marca && (
          <p class:list={['rotulo text-[9px]', escuro ? 'text-white/40' : 'text-tinta-400']}>
            {p.marca}
          </p>
        )
      }
      <h3
        class:list={[
          'mt-1.5 text-[15px] leading-snug font-semibold',
          escuro ? 'text-white' : 'text-tinta-950',
        ]}
      >
        {p.nome}
      </h3>
      {
        p.tamanhos && (
          <p class:list={['mt-1.5 text-xs', escuro ? 'text-white/45' : 'text-tinta-400']}>
            Tam. {p.tamanhos}
          </p>
        )
      }
    </div>

    <div
      class:list={[
        'flex items-end justify-between gap-3 border-t pt-3.5',
        escuro ? 'border-white/12' : 'border-tinta-950/10',
      ]}
    >
      <div class="min-w-0">
        {
          precoFmt ? (
            <Fragment>
              {p.precoAntigo && (
                <span
                  class:list={[
                    'block text-xs line-through',
                    escuro ? 'text-white/35' : 'text-tinta-400',
                  ]}
                >
                  {moeda.format(p.precoAntigo)}
                </span>
              )}
              <span
                class:list={[
                  'display text-2xl',
                  p.precoAntigo ? 'text-ambar-600' : escuro ? 'text-white' : 'text-tinta-950',
                ]}
              >
                {precoFmt}
              </span>
            </Fragment>
          ) : (
            <span
              class:list={['text-[13px] leading-snug', escuro ? 'text-white/50' : 'text-tinta-500']}
            >
              Consulte o valor
            </span>
          )
        }
      </div>

      <a
        href={href}
        target="_blank"
        rel="noopener"
        aria-label={rotuloBotao}
        class:list={[
          'flex size-10 shrink-0 items-center justify-center rounded-full border transition-all duration-300',
          escuro
            ? 'border-white/20 text-white/70 hover:border-zap-500 hover:bg-zap-500 hover:text-tinta-950'
            : 'border-tinta-950/20 text-tinta-600 hover:border-zap-500 hover:bg-zap-500 hover:text-tinta-950',
        ]}
      >
        <Icone nome="whatsapp" class="size-4.5" />
      </a>
    </div>
  </div>
</article>
