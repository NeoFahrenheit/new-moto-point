---
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { moeda, desconto, type Produto } from '../data/catalogo';
import { zapProduto } from '../data/site';

interface Props {
  produto: Produto;
  /** Cartão claro (fundo branco) ou escuro. */
  tema?: 'claro' | 'escuro';
  atraso?: number;
}

const { produto: p, tema = 'escuro', atraso = 0 } = Astro.props;

const off = desconto(p);
const precoFmt = p.preco ? moeda.format(p.preco) : null;
const claro = tema === 'claro';
const href = zapProduto(p.nome + (p.tamanhos ? ` — tam. ${p.tamanhos}` : ''), precoFmt ?? undefined);
---

<article
  class:list={[
    'reveal group relative flex flex-col border transition-all duration-300',
    claro
      ? 'border-carbon-950/12 bg-white hover:border-rubi-500'
      : 'border-white/10 bg-carbon-850 hover:border-rubi-500',
  ]}
  style={atraso ? `--reveal-delay:${atraso}ms` : undefined}
>
  {
    off !== null && (
      <span class="grad-rubi absolute top-0 left-0 z-10 px-3 py-1.5 text-[11px] font-extrabold tracking-wider text-white">
        −{off}%
      </span>
    )
  }

  <!-- Foto sempre em fundo claro: os produtos foram fotografados em estúdio branco -->
  <div class="relative aspect-square overflow-hidden bg-white p-4">
    <Image
      src={p.img}
      alt={p.nome}
      widths={[240, 400, 600]}
      sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 80vw"
      loading="lazy"
      decoding="async"
      class="size-full object-contain transition-transform duration-500 ease-out-quint group-hover:scale-[1.07]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex-1">
      {
        p.marca && (
          <p
            class:list={[
              'rotulo text-[9.5px]',
              claro ? 'text-carbon-500' : 'text-white/40',
            ]}
          >
            {p.marca}
          </p>
        )
      }
      <h3
        class:list={[
          'mt-1.5 text-[15px] leading-snug font-semibold',
          claro ? 'text-carbon-950' : 'text-white',
        ]}
      >
        {p.nome}
      </h3>
      {
        p.tamanhos && (
          <p class:list={['mt-1.5 text-xs', claro ? 'text-carbon-500' : 'text-white/45']}>
            Tam. {p.tamanhos}
          </p>
        )
      }
    </div>

    <div>
      {
        precoFmt ? (
          <div class="flex flex-wrap items-baseline gap-2">
            {p.precoAntigo && (
              <span
                class:list={[
                  'text-sm line-through',
                  claro ? 'text-carbon-500' : 'text-white/35',
                ]}
              >
                {moeda.format(p.precoAntigo)}
              </span>
            )}
            <span
              class:list={[
                'display text-2xl',
                p.precoAntigo ? 'text-rubi-500' : claro ? 'text-carbon-950' : 'text-white',
              ]}
            >
              {precoFmt}
            </span>
          </div>
        ) : (
          <p
            class:list={[
              'py-1 text-[12.5px] font-bold tracking-[0.14em] uppercase',
              claro ? 'text-carbon-500' : 'text-white/45',
            ]}
          >
            Consulte o valor
          </p>
        )
      }

      <a
        href={href}
        target="_blank"
        rel="noopener"
        class:list={[
          'mt-3 flex items-center justify-center gap-2 rounded-sm px-4 py-2.5 text-[12px] font-extrabold tracking-wider uppercase transition-colors',
          claro
            ? 'bg-carbon-950 text-white hover:bg-zap-500 hover:text-carbon-950'
            : 'bg-white/8 text-white hover:bg-zap-500 hover:text-carbon-950',
        ]}
      >
        <Icone nome="whatsapp" class="size-4.5" />
        {precoFmt ? 'Quero este' : 'Orçamento'}
      </a>
    </div>
  </div>
</article>
